# ==========================
# Database configuration
# ==========================
db.driver=
db.url=
db.user=
db.password=

flyway.url=
flyway.user=
flyway.password=
flyway.cleanDisabled=false

# ==========================
# Hibernate
# ==========================
hibernate.dialect=
hibernate.show_sql=
hibernate.hbm2ddl.auto=

